# Generated caches and local editor/environment files only. Data is included intentionally.
__pycache__/
*.py[cod]
.venv/
venv/
.idea/
.vscode/
.env
.env.*
!.env.example
Thumbs.db
Desktop.ini

# Model checkpoints are delivered through external storage, not Git/course zip.
/*.pt

# Member 4's regenerable evaluation artifacts
src/outputs/eval_split/predictions/
src/outputs/eval_split/errors/

# Model weights: regenerable via src/bert_gp/train.py. Do not commit.
src/outputs/bert_gp/*/best.pt

# Downloaded tokenizer caches and large regenerable outputs. Keep only the small
# evidence files (metrics.json, manifest.json, test_four_models_summary.json).
src/outputs/bert_gp/*/tokenizer/
src/outputs/bert_gp/*/predictions.jsonl
src/outputs/bert_gp/*/errors.json
src/outputs/llm/*/predictions.jsonl
src/outputs/llm/*/errors.json

# Raw API responses and original text are data material, not code.
src/outputs/llm/*/audit.jsonl
src/outputs/llm/*/inputs.jsonl

# 成员3交付的数据包（含原文的预测材料，按组内授权共享，不入库）
best_macbert_tune_handoff/
macbert_5ep_low_score_tune/

# 融合实验产物（tune 上的结果级融合实验，结论为无显著收益，不纳入仓库）
src/outputs/fusion/

# Local one-command reproduction artifacts
src/reproduction_outputs/

# 成员四
/ignore
